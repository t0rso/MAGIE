---
import Foto from './Foto.astro';
import Drip from './Drip.astro';
interface Props { prima?: boolean }
const { prima = false } = Astro.props;
---
<section class:list={['relative bg-fragola text-white on-dark', !prima && 'mt-16']}>
  <div class="mx-auto max-w-6xl px-5 sm:px-6 pt-12 pb-14 md:py-20 grid gap-8 md:gap-12 md:grid-cols-[1fr_1fr] items-center">
    <div class="reveal text-center md:text-left order-2 md:order-1">
      <p class="text-[11px] sm:text-xs font-black uppercase tracking-[.2em] text-limone">Torte gelato su ordinazione</p>
      <h2 class="mt-3 text-3xl sm:text-5xl font-semibold">Una torta che possono mangiare <span class="underline-brush" style="--brush:#C7405A">tutti gli invitati.</span></h2>
      <p class="mt-4 text-base sm:text-lg text-white/90 max-w-md mx-auto md:mx-0">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <div class="mt-7 flex flex-col sm:flex-row items-center gap-4">
        <a href="/torte#ordina" class="btn btn-primary btn-lg w-full sm:w-auto">Ordina una torta</a>
        <a href="/torte" class="btn-link">Vedi le torte →</a>
      </div>
    </div>
    <div class="reveal order-1 md:order-2 mx-auto w-[min(70vw,300px)] md:w-full md:max-w-md">
      <Foto nome="torta-hero" alt="Torta gelato Magie decorata" ratio="1/1" scontornata nota="Una torta finita, vista di 3/4" sizes="(min-width: 768px) 448px, 70vw" />
    </div>
  </div>
  <Drip color="#E85D75" />
</section>
