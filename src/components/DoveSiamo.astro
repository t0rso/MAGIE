---
import info from '../data/info.json';
import { orari, GIORNI_ORDINATI, GIORNI_LABEL, formattaFasce, orariUniformi } from '../lib/orari';
import StatoApertura from './StatoApertura.astro';
import Titolo from './Titolo.astro';
import Foto from './Foto.astro';
import SocialButton from './SocialButton.astro';
interface Props { compatto?: boolean }
const { compatto = false } = Astro.props;
const q = encodeURIComponent(`Gelateria Magie, ${info.indirizzo.via}, ${info.indirizzo.citta}`);
const mapSrc = `https://www.google.com/maps?q=${q}&z=16&output=embed`;
const uniforme = orariUniformi(orari);
---
<section class="mx-auto max-w-6xl px-5 sm:px-6 py-16 md:py-20" id="dove">
  {!compatto && <Titolo occhiello="Dove e quando" brush="var(--color-limone)">Via Covignano, <span class="underline-brush">tutti i giorni</span> dalle 14:30.</Titolo>}

  <div class:list={['grid gap-4 md:gap-6 md:grid-cols-[1fr_1.3fr]', !compatto && 'mt-8']}>
    <div class="card p-5 sm:p-6 reveal flex flex-col gap-5">
      <StatoApertura />
      <address class="not-italic text-lg leading-snug">
        <strong>Gelateria Magie</strong><br />
        {info.indirizzo.via}, {info.indirizzo.citta}
      </address>
      {uniforme ? (
        <p class="text-cacao/85">Tutti i giorni <strong>{uniforme}</strong></p>
      ) : (
        <table class="w-full text-sm"><tbody>
          {GIORNI_ORDINATI.map((g) => (
            <tr class="border-t border-cialda"><th class="py-1.5 text-left font-extrabold">{GIORNI_LABEL[g]}</th><td class="py-1.5 text-right">{formattaFasce(orari[g])}</td></tr>
          ))}
        </tbody></table>
      )}
      <div class="grid gap-3 mt-auto">
        <a href={info.social.google} target="_blank" rel="noopener" class="btn btn-primary">Portami lì</a>
        <div class="grid grid-cols-2 gap-3">
          <SocialButton tipo="whatsapp" class="btn-sm" />
          <SocialButton tipo="telefono" label="Chiama" class="btn-sm" />
        </div>
      </div>
    </div>
    <div class="grid gap-4 md:gap-6 md:grid-rows-[auto_1fr] reveal">
      {!compatto && <Foto nome="esterno-sera" alt="L'ingresso della gelateria Magie di sera, con i tavolini fuori" ratio="16/9" nota="L'ingresso con i tavolini, di sera" class="md:!aspect-[2/1]" />}
      <div class="card overflow-hidden relative min-h-56 md:min-h-64">
        <iframe src={mapSrc} title="Mappa: Gelateria Magie, via Covignano 152, Rimini" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="absolute inset-0 w-full h-full border-0 grayscale-[.2] contrast-[1.05]"></iframe>
      </div>
    </div>
  </div>
</section>
