---
import type { Gusto } from '../lib/types';
import VincoloChip from './VincoloChip.astro';
import Placeholder from './Placeholder.astro';
interface Props { gusto: Gusto }
const { gusto: g } = Astro.props;
---
<article class="card p-4 sm:p-5 flex gap-3 sm:gap-4 items-start"
         data-gusto data-categoria={g.categoria} data-vincoli={g.vincoli.join(' ')}>
  <span class="scoop shrink-0 w-10 sm:w-12 mt-0.5" style={`--c:${g.colore}`} aria-hidden="true"></span>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
      <h3 class="text-lg sm:text-xl font-bold leading-tight">{g.nome}</h3>
      {g.stagionale && <span class="text-xs font-extrabold text-caramello">di stagione</span>}
    </div>
    <p class="mt-0.5 text-sm sm:text-base text-cacao/85">{g.descrizione}</p>
    {(g.vincoli.length > 0 || g.daConfermare) && (
      <div class="mt-2 flex flex-wrap gap-1.5 items-center">
        {g.vincoli.map((v) => <VincoloChip id={v} small />)}
        {g.daConfermare && <Placeholder />}
      </div>
    )}
    <p class="mt-1.5 text-[11px] sm:text-xs text-cacao/60">
      {g.allergeni.length ? `Contiene: ${g.allergeni.join(', ')}` : 'Senza allergeni principali'}
    </p>
  </div>
</article>
