---
import type { Gusto } from '../lib/types';
import VincoloChip from './VincoloChip.astro';
import Placeholder from './Placeholder.astro';
interface Props { gusto: Gusto }
const { gusto: g } = Astro.props;
---
<article class="card group p-5 flex gap-4 items-start"
         data-gusto data-categoria={g.categoria} data-vincoli={g.vincoli.join(' ')}>
  <span class="scoop shrink-0 w-16 anim-float" style={`--c:${g.colore}; animation-delay:${(g.nome.length % 5) * -0.7}s`} aria-hidden="true"></span>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-xl font-bold">{g.nome}</h3>
      {g.stagionale && <span class="text-xs font-extrabold text-caramello">di stagione</span>}
      {g.daConfermare && <Placeholder />}
    </div>
    <p class="mt-1 text-cacao/90">{g.descrizione}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {g.vincoli.map((v) => <VincoloChip id={v} small />)}
    </div>
    <p class="mt-2 text-xs text-cacao/70">
      {g.allergeni.length ? `Contiene: ${g.allergeni.join(', ')}` : 'Senza allergeni principali'}
    </p>
  </div>
</article>
