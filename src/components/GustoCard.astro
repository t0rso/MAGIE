---
import type { Gusto } from '../lib/types';
import { CATEGORIE, testoSuColore } from '../lib/gusti';
import AllergeniBadge from './AllergeniBadge.astro';

interface Props { gusto: Gusto; compatto?: boolean }
const { gusto, compatto = false } = Astro.props;
const tono = testoSuColore(gusto.colore);
---
<article
  class:list={[
    'gusto-card group relative flex flex-col overflow-hidden rounded-blob shadow-soft transition hover:-translate-y-1',
    tono === 'light' ? 'text-crema-50' : 'text-cacao-900',
    compatto ? 'min-h-40 p-5' : 'min-h-56 p-6',
  ]}
  style={`background: ${gusto.colore}`}
  data-gusto-id={gusto.id}
  data-nome={gusto.nome.toLowerCase()}
  data-categoria={gusto.categoria}
  data-tag={gusto.tag.join('|')}
  data-disponibile={String(gusto.disponibileOggi)}
>
  <!-- riflesso "gelato" -->
  <span aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 size-32 rounded-full bg-white/25 blur-2xl transition group-hover:scale-125"></span>

  <div class="flex items-start justify-between gap-2">
    <span class="rounded-full bg-black/10 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider">{CATEGORIE[gusto.categoria]}</span>
    <span class="badge-oggi whitespace-nowrap rounded-full bg-white px-2.5 py-0.5 text-xs font-bold text-cacao-900 shadow" data-badge>
      {compatto ? '✨ Oggi' : 'Oggi in vetrina'}
    </span>
  </div>

  <h3 class:list={['mt-auto font-bold leading-tight', compatto ? 'text-xl pt-4' : 'text-2xl pt-6']}>{gusto.nome}</h3>
  {!compatto && <p class="mt-2 text-sm/relaxed opacity-90">{gusto.descrizione}</p>}

  <div class="mt-4 flex flex-wrap items-end justify-between gap-2">
    <AllergeniBadge allergeni={gusto.allergeni} compatto />
    {!compatto && gusto.tag.length > 0 && (
      <ul class="flex flex-wrap gap-1">
        {gusto.tag.filter((t) => t !== 'signature').map((t) => (
          <li class="rounded-full border border-current/30 px-2 py-0.5 text-[11px] font-medium capitalize">{t}</li>
        ))}
      </ul>
    )}
  </div>
  {gusto.tag.includes('signature') && (
    <span class="absolute bottom-0 right-0 rounded-tl-2xl bg-fragola-500 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white">Signature</span>
  )}
</article>

<style>
  .gusto-card[data-disponibile='false'] .badge-oggi { display: none; }
  .gusto-card[data-disponibile='false'] { filter: saturate(0.55); opacity: 0.8; }
</style>
