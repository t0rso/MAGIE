---
import info from '../data/info.json';
import { GIORNI_ORDINATI, GIORNI_LABEL, formattaFasce, orari } from '../lib/orari';
const anno = new Date().getFullYear();
---
<footer class="mt-24 border-t border-cacao-900/10 bg-crema-100">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-3xl font-bold">{info.nome}</p>
      <p class="mt-2 max-w-xs text-cacao-700">{info.claim}</p>
      <div class="mt-5 flex gap-3">
        <a href={info.social.facebook} class="chip" target="_blank" rel="noopener">Facebook</a>
        <a href={info.social.instagram} class="chip" target="_blank" rel="noopener">Instagram</a>
        <a href={info.social.google} class="chip" target="_blank" rel="noopener">★ Google</a>
      </div>
    </div>
    <div>
      <p class="eyebrow">Dove siamo</p>
      <address class="mt-3 not-italic leading-relaxed">
        {info.indirizzo.via}<br />{info.indirizzo.cap} {info.indirizzo.citta}
      </address>
      <p class="mt-3"><a class="underline-offset-4 hover:underline" href={`tel:${info.telefono.replace(/\s/g, '')}`}>{info.telefono}</a></p>
      <p><a class="underline-offset-4 hover:underline" href={`mailto:${info.email}`}>{info.email}</a></p>
    </div>
    <div>
      <p class="eyebrow">Orari</p>
      <ul class="mt-3 space-y-1 text-sm">
        {GIORNI_ORDINATI.map((g) => (
          <li class="flex justify-between gap-4" data-giorno={g}>
            <span>{GIORNI_LABEL[g]}</span>
            <span class="text-cacao-700">{formattaFasce(orari[g] ?? null)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-cacao-900/10">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-cacao-700 sm:flex-row sm:justify-between">
      <span>© {anno} Gelateria Magie · {info.indirizzo.citta} · P.IVA da inserire</span>
      <span>Sito dimostrativo · <a href="/admin" class="hover:underline">Area gestione</a></span>
    </div>
  </div>
</footer>
