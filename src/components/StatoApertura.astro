---
import { orari, orariUniformi } from '../lib/orari';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const fallback = orariUniformi(orari) ? `Tutti i giorni ${orariUniformi(orari)}` : 'Vedi orari';
---
<span class:list={['inline-flex items-center gap-2 rounded-full bg-panna px-3.5 py-2 text-sm font-extrabold shadow-soft', cls]}
      data-stato={JSON.stringify(orari)} data-aperto="">
  <span class="size-2.5 rounded-full bg-nocciola [[data-aperto=true]_&]:bg-pistacchio-scuro [[data-aperto=true]_&]:dot-live [[data-aperto=false]_&]:bg-fragola" aria-hidden="true"></span>
  <span data-stato-testo>{fallback}</span>
</span>
