---
import voci from '../data/nonSoloGelato.json';
import Titolo from './Titolo.astro';
import Drip from './Drip.astro';
import Foto from './Foto.astro';
---
<div class="relative" aria-hidden="true"><Drip color="#FBF3E4" /></div>
<section class="relative bg-cialda mt-0">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 pt-16 pb-14 md:pt-24 md:pb-20">
    <Titolo occhiello="Non solo coni" brush="var(--color-pesca)">Ai tavolini, <span class="underline-brush">la sera.</span></Titolo>
    <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 reveal-stagger">
      {voci.map((v) => (
        <div class="card overflow-hidden">
          <Foto nome={v.foto} alt={v.nome} ratio="4/3" nota={v.fotoNota} class="!rounded-none !shadow-none" sizes="(min-width: 1024px) 280px, 50vw" />
          <div class="p-3 sm:p-5">
            <h3 class="text-base sm:text-xl font-bold">{v.nome}</h3>
            <p class="mt-1 text-sm text-cacao/85 hidden sm:block">{v.testo}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
  <Drip color="#F2E3C6" />
</section>
