---
import info from '../data/info.json';

const nav = [
  { href: '/gusti', label: 'Gusti' },
  { href: '/torte', label: 'Torte & vaschette' },
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/contatti', label: 'Contatti' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-40 border-b border-cacao-900/5 bg-crema-50/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-display text-2xl font-bold tracking-tight" aria-label="Home">
      <span class="grid size-9 place-items-center rounded-full bg-fragola-500 text-white text-lg">🍨</span>
      <span>{info.nome}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principale">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['rounded-full px-4 py-2 text-sm font-medium transition hover:bg-crema-200', path.startsWith(n.href) && 'bg-crema-200']}
          aria-current={path.startsWith(n.href) ? 'page' : undefined}
        >{n.label}</a>
      ))}
      <a href="/torte#prenota" class="btn-accent ml-2 !px-5 !py-2 text-sm">Prenota una torta</a>
    </nav>

    <button
      id="nav-toggle"
      class="grid size-11 place-items-center rounded-full hover:bg-crema-200 md:hidden"
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Apri menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="line-top" d="M4 7h16" /><path class="line-mid" d="M4 12h16" /><path class="line-bot" d="M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="nav-mobile" class="hidden border-t border-cacao-900/5 bg-crema-50 md:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Principale mobile">
      {nav.map((n) => (
        <a href={n.href} class="rounded-2xl px-4 py-3 text-lg font-medium hover:bg-crema-200">{n.label}</a>
      ))}
      <a href="/torte#prenota" class="btn-accent mt-2">Prenota una torta</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
  });
</script>
