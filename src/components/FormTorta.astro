---
import info from '../data/info.json';
import { torte, vincoli } from '../lib/gusti';
const min = new Date(Date.now() + 2 * 864e5).toISOString().slice(0, 10);
---
<div class="card p-6 sm:p-8" id="ordina">
  <h2 class="text-3xl font-semibold">Ordina la tua torta</h2>
  <p class="mt-2 text-cacao/90">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>

  <form name="ordine-torta" method="POST" data-netlify="true" netlify-honeypot="sito" action="/torte?ok=1#ordina" class="mt-6 grid gap-5" data-form-torta data-wa={info.whatsapp}>
    <input type="hidden" name="form-name" value="ordine-torta" />
    <p class="hidden"><label>Non compilare: <input name="sito" /></label></p>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="field"><label for="nome">Il tuo nome</label><input id="nome" name="nome" required autocomplete="name" /></div>
      <div class="field"><label for="telefono">Telefono</label><input id="telefono" name="telefono" type="tel" required autocomplete="tel" placeholder="Per confermarti l'ordine" /></div>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <div class="field"><label for="data">Giorno del ritiro</label><input id="data" name="data" type="date" required min={min} /></div>
      <div class="field"><label for="ora">Ora</label><input id="ora" name="ora" type="time" min="14:30" max="23:30" value="18:00" /></div>
      <div class="field"><label for="porzioni">Porzioni</label>
        <select id="porzioni" name="porzioni">
          {['6', '8', '10', '12', '15', '20'].map((p) => <option value={p} selected={p === '10'}>{p} persone</option>)}
        </select>
      </div>
    </div>

    <div class="field"><label for="torta">Che torta?</label>
      <select id="torta" name="torta">
        {torte.map((t) => <option value={t.nome}>{t.nome}</option>)}
      </select>
    </div>

    <fieldset class="grid gap-2">
      <legend class="font-extrabold text-sm mb-1">Deve essere…</legend>
      <div class="grid grid-cols-2 gap-3">
        {vincoli.map((v) => (
          <label class="check check-tile"><input type="checkbox" name="vincoli" value={v.nome} /><span><i class="not-italic text-xl" aria-hidden="true">{v.emoji}</i>{v.nome}</span></label>
        ))}
      </div>
    </fieldset>

    <div class="field"><label for="gusti">Gusti che vorresti</label><input id="gusti" name="gusti" placeholder="Es. pistacchio e fragola, oppure «fate voi»" /></div>
    <div class="field"><label for="scritta">Scritta sulla torta</label><input id="scritta" name="scritta" placeholder="Es. Auguri Giulia!" /></div>
    <div class="field"><label for="note">Note</label><textarea id="note" name="note" rows="3" placeholder="Allergie, decorazioni, foto in cialda…"></textarea></div>

    <div class="grid gap-3 pt-2">
      <button type="submit" class="btn btn-primary btn-lg w-full">Invia la richiesta</button>
      <a href={`https://wa.me/${info.whatsapp}`} target="_blank" rel="noopener" class="btn btn-social btn-lg w-full" style="background:#25D366;color:#fff" data-wa-link>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4M12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8m8.4-18.2A11.8 11.8 0 0 0 12 .1C5.5.1.2 5.4.2 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.3-1.7c1.7.9 3.7 1.4 5.7 1.4 6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.4-8.3"/></svg>
        Manda su WhatsApp
      </a>
    </div>
    <p class="text-xs text-cacao/70">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Telefono: <a class="underline" href={`tel:${info.telefonoTel}`}>{info.telefono}</a>.</p>
  </form>

  <div class="hidden rounded-2xl bg-pistacchio/25 p-5 font-bold" data-form-ok>
    🎉 Richiesta inviata! Ti richiamiamo per confermare gusti, orario e prezzo.
  </div>
</div>

<script src="../scripts/torta-form.ts"></script>
