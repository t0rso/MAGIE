---
/**
 * Foto del locale: `src/assets/foto/<nome>.jpg` oppure l'alias in alias.json.
 * Se manca, un segnaposto che dice quale scatto serve (lista in src/assets/foto/README.md).
 */
import { Image } from 'astro:assets';
import { trovaFoto } from '../lib/foto';

interface Props {
  nome: string;
  alt: string;
  ratio?: string;
  /** PNG con sfondo trasparente: niente cornice. Un JPG viene comunque mostrato incorniciato. */
  scontornata?: boolean;
  nota?: string;
  class?: string;
  priority?: boolean;
  sizes?: string;
}
const { nome, alt, ratio = '4/3', scontornata = false, nota = '', class: cls = '', priority = false, sizes = '(min-width: 768px) 50vw, 100vw' } = Astro.props;
const img = trovaFoto(nome);
const comeScontornata = scontornata && !!img && /png|webp|avif/.test(img.format);
---
{img ? (
  <Image
    src={img}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class:list={[comeScontornata ? 'foto-scontornata' : 'foto', cls]}
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div class:list={['foto-placeholder', scontornata && 'is-scontornata', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Segnaposto foto: ${alt}`}>
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>
    </svg>
    <p class="foto-placeholder-titolo">{nota || alt}</p>
    <p class="foto-placeholder-file">foto/{nome}.{scontornata ? 'png' : 'jpg'}</p>
  </div>
)}
