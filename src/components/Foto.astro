---
/**
 * Foto reale del locale. Cerca `src/assets/foto/<nome>.(jpg|png|webp)`:
 * se c'è la mostra ottimizzata, altrimenti un segnaposto che dice quale scatto serve.
 * L'elenco degli scatti richiesti è in src/assets/foto/README.md.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nome: string;
  alt: string;
  /** Es. "4/5", "1/1", "21/9". Con `scontornata` è la proporzione dell'ingombro. */
  ratio?: string;
  /** PNG con sfondo trasparente: niente cornice, l'oggetto "galleggia" sullo sfondo. */
  scontornata?: boolean;
  /** Cosa deve esserci nella foto (mostrato nel segnaposto). */
  nota?: string;
  class?: string;
  priority?: boolean;
  sizes?: string;
}
const { nome, alt, ratio = '4/3', scontornata = false, nota = '', class: cls = '', priority = false, sizes = '(min-width: 768px) 50vw, 100vw' } = Astro.props;

const tutte = import.meta.glob<{ default: ImageMetadata }>('../assets/foto/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const trovata = Object.entries(tutte).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === nome)?.[1].default;
const ext = scontornata ? 'png' : 'jpg';
---
{trovata ? (
  <Image
    src={trovata}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class:list={[scontornata ? 'foto-scontornata' : 'foto', cls]}
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div class:list={['foto-placeholder', scontornata && 'is-scontornata', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Segnaposto foto: ${alt}`}>
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>
    </svg>
    <p class="foto-placeholder-titolo">{nota || alt}</p>
    <p class="foto-placeholder-file">foto/{nome}.{ext}{scontornata && ' · sfondo trasparente'}</p>
  </div>
)}
