---
interface Props { class?: string; big?: boolean }
const { class: cls = '', big = false } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2', cls]}>
  <svg width={big ? 44 : 32} height={big ? 44 : 32} viewBox="0 0 64 64" aria-hidden="true" class="transition-transform duration-500 group-hover:rotate-[-10deg]">
    <path d="M20 34h24L32 60z" fill="#C69C6D"/>
    <path d="M22 36l4 6M30 36l4 8M38 36l-4 8M28 44l3 6M36 44l-3 6" stroke="#A0714F" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="32" cy="30" r="12" fill="#8FB57A"/>
    <circle cx="24" cy="21" r="10" fill="#E85D75"/>
    <circle cx="40" cy="21" r="10" fill="#FBF3E4" stroke="#F2E3C6"/>
  </svg>
  <span class:list={['display font-black tracking-tight', big ? 'text-4xl' : 'text-2xl']}>Magie</span>
</span>
