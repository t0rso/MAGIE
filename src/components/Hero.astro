---
import info from '../data/info.json';
import StatoApertura from './StatoApertura.astro';
---
<section class="relative overflow-hidden">
  <!-- macchie di colore "gelato" sullo sfondo -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <span class="absolute -left-20 top-10 size-72 rounded-full bg-pistacchio-300/50 blur-3xl"></span>
    <span class="absolute right-0 top-40 size-80 rounded-full bg-fragola-400/30 blur-3xl"></span>
    <span class="absolute bottom-0 left-1/3 size-64 rounded-full bg-[#F5D98B]/50 blur-3xl"></span>
  </div>

  <div class="container-page grid items-center gap-10 py-14 md:grid-cols-2 md:py-24">
    <div class="fade-up">
      <StatoApertura />
      <h1 class="mt-5 text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
        Gelato fatto <span class="text-fragola-500">ogni mattina</span>, con le mani e con la testa.
      </h1>
      <p class="mt-6 max-w-lg text-lg text-cacao-700">
        Latte fresco, frutta di stagione, pistacchio di Bronte. Niente basi pronte, niente coloranti.
        Vieni ad assaggiare cosa succede quando il gelato lo fai davvero.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/gusti" class="btn-primary">Scopri i gusti di oggi</a>
        <a href="/contatti" class="btn-ghost">Come raggiungerci</a>
      </div>
      <p class="mt-6 text-sm text-cacao-700">
        {info.indirizzo.via}, {info.indirizzo.citta} · <a class="underline underline-offset-4" href={`tel:${info.telefono.replace(/\s/g, '')}`}>{info.telefono}</a>
      </p>
    </div>

    <div class="fade-up fade-up-delay relative mx-auto w-full max-w-md md:max-w-none">
      <img
        src="https://images.unsplash.com/photo-1567206563064-6f60f40a2b57?auto=format&fit=crop&w=900&q=80"
        alt="Coppette di gelato artigianale al pistacchio e fragola"
        width="900"
        height="1100"
        class="aspect-[4/5] w-full rounded-blob object-cover shadow-soft"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute -bottom-5 -left-3 rounded-2xl bg-white px-4 py-3 shadow-soft sm:-left-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-pistacchio-700">Oggi in vetrina</p>
        <p class="font-display text-2xl font-bold" data-conteggio-oggi>— gusti</p>
      </div>
    </div>
  </div>
</section>
