---
/** Bottone social in stile WhatsApp: pillola colorata con icona. */
import info from '../data/info.json';
interface Props { tipo: 'whatsapp' | 'instagram' | 'facebook' | 'telefono'; label?: string; class?: string; testo?: string }
const { tipo, label, class: cls = '', testo } = Astro.props;
const conf = {
  whatsapp: { href: `https://wa.me/${info.whatsapp}${testo ? `?text=${encodeURIComponent(testo)}` : ''}`, label: 'WhatsApp', bg: '#25D366', fg: '#fff' },
  instagram: { href: info.social.instagram, label: 'Instagram', bg: 'linear-gradient(45deg,#f9ce34,#ee2a7b 55%,#6228d7)', fg: '#fff' },
  facebook: { href: info.social.facebook, label: 'Facebook', bg: '#1877F2', fg: '#fff' },
  telefono: { href: `tel:${info.telefonoTel}`, label: info.telefono, bg: 'var(--color-cioccolato)', fg: 'var(--color-crema)' },
}[tipo];
const esterno = tipo === 'instagram' || tipo === 'facebook';
---
<a href={conf.href} target={esterno ? '_blank' : undefined} rel={esterno ? 'noopener' : undefined}
   class:list={['btn btn-social', cls]} style={`background:${conf.bg}; color:${conf.fg}`}>
  {tipo === 'whatsapp' && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4M12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8m8.4-18.2A11.8 11.8 0 0 0 12 .1C5.5.1.2 5.4.2 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.3-1.7c1.7.9 3.7 1.4 5.7 1.4 6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.4-8.3"/></svg>}
  {tipo === 'instagram' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1" fill="currentColor" stroke="none"/></svg>}
  {tipo === 'facebook' && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8z"/></svg>}
  {tipo === 'telefono' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>}
  <span>{label ?? conf.label}</span>
</a>
