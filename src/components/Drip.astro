---
/**
 * Colata tra sezioni: il colore della sezione che la contiene cola su quella sotto.
 * Va dentro una sezione `relative`, in fondo. `color` = sfondo della sezione che cola.
 */
interface Props { color: string; class?: string }
const { color, class: cls = '' } = Astro.props;
// Gocce: [x, larghezza, lunghezza, ritardo]
const gocce: [number, number, number, number][] = [
  [90, 34, 62, 0], [260, 26, 40, 1.3], [430, 40, 78, 0.6], [640, 28, 46, 2.1], [800, 36, 70, 0.3], [990, 24, 38, 1.7], [1130, 32, 56, 1.0],
];
---
<div class:list={['colata-sez', cls]} aria-hidden="true">
  <svg viewBox="0 0 1200 100" preserveAspectRatio="none">
    <path fill={color} d="M0,0 H1200 V14 C1170,14 1160,26 1130,26 C1100,26 1100,10 1060,10 C1020,10 1020,22 990,22 C960,22 960,8 920,8 C880,8 880,24 840,24 C810,24 810,12 780,12 C740,12 740,28 700,28 C670,28 670,14 640,14 C600,14 600,24 560,24 C530,24 530,10 500,10 C460,10 460,26 430,26 C400,26 400,12 360,12 C320,12 320,22 290,22 C260,22 260,8 230,8 C190,8 190,26 150,26 C120,26 120,14 90,14 C60,14 60,20 30,20 C15,20 8,16 0,16 Z"/>
    <g fill={color}>
      {gocce.map(([x, w, l, d]) => (
        <g class="colata-goccia-sez" style={`--d:${d}s; transform-origin:${x}px 10px`}>
          <path d={`M${x - w / 2},10 v${l - w / 2} a${w / 2},${w / 2} 0 0 0 ${w},0 v-${l - w / 2} z`} />
        </g>
      ))}
    </g>
  </svg>
</div>
