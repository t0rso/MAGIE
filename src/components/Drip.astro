---
/** Bordo ondulato tra sezioni: il colore della sezione che lo contiene scende su quella sotto. Statico. */
interface Props { color: string; class?: string }
const { color, class: cls = '' } = Astro.props;
---
<div class:list={['colata-sez', cls]} aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path fill={color} d="M0,0 H1200 V22 C1140,22 1120,44 1050,44 C980,44 960,18 890,18 C820,18 800,46 730,46 C660,46 640,20 570,20 C500,20 480,42 410,42 C340,42 320,16 250,16 C180,16 160,40 90,40 C50,40 30,28 0,28 Z"/>
  </svg>
</div>
