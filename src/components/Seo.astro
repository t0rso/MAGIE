---
import info from '../data/info.json';
import { orariSchema, orari } from '../lib/orari';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = info.descrizione, image = '/og-image.svg' } = Astro.props;
const fullTitle = title === info.nome ? `${info.nome} · ${info.sottotitolo}` : `${title} · ${info.nome}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'IceCreamShop',
  name: `Gelateria ${info.nome}`,
  description: info.descrizione,
  url: Astro.site?.toString(),
  telephone: [info.cellulare, info.telefono],
  email: info.email,
  image: ogImage.toString(),
  priceRange: '€',
  servesCuisine: 'Gelato artigianale',
  address: {
    '@type': 'PostalAddress',
    streetAddress: info.indirizzo.via,
    postalCode: info.indirizzo.cap,
    addressLocality: info.indirizzo.citta,
    addressRegion: info.indirizzo.provincia,
    addressCountry: 'IT',
  },
  geo: { '@type': 'GeoCoordinates', latitude: info.indirizzo.lat, longitude: info.indirizzo.lng },
  openingHoursSpecification: orariSchema(orari),
  sameAs: [info.social.facebook, info.social.instagram],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: info.google.voto, reviewCount: info.google.recensioni },
  hasDeliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
};
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={`Gelateria ${info.nome}`} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="it_IT" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#fdfaf3" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
