---
import { vincoli, gustiCon } from '../lib/gusti';
import Titolo from './Titolo.astro';
---
<section class="mx-auto max-w-6xl px-4 sm:px-6 py-20" id="per-chi">
  <Titolo occhiello="Per chi di solito rinuncia" brush="var(--color-menta)">
    Il gelato che <span class="underline-brush">non ti fa</span> chiedere «ma posso?»
    <Fragment slot="sotto">Vegano, con stevia, senza lattosio, senza glutine: non un angolino del banco, ma una parte vera del laboratorio. Da oltre vent'anni.</Fragment>
  </Titolo>

  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 reveal-stagger">
    {vincoli.map((v) => {
      const n = gustiCon(v.id).length;
      return (
        <a href={v.url} class="card group p-6 flex flex-col gap-4 relative overflow-hidden">
          <span class="absolute -right-8 -top-8 size-32 rounded-full opacity-40 transition-transform duration-700 group-hover:scale-[1.8]" style={`background:${v.colore}`} aria-hidden="true"></span>
          <span class="scoop w-14 relative" style={`--c:${v.colore}`} aria-hidden="true"></span>
          <div class="relative">
            <h3 class="text-2xl font-bold">{v.emoji} {v.nome}</h3>
            <p class="mt-1 text-cacao/90">{v.descrizione}</p>
          </div>
          <p class="relative mt-auto text-sm font-black text-cioccolato/70">{n} gusti oggi →</p>
        </a>
      );
    })}
  </div>
</section>
