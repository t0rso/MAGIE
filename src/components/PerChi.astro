---
import { vincoli } from '../lib/gusti';
import Titolo from './Titolo.astro';
---
<section class="mx-auto max-w-6xl px-5 sm:px-6 pt-24 pb-10 md:pt-32 md:pb-20" id="per-chi">
  <Titolo brush="var(--color-menta)" center>Scegli per <span class="underline-brush">come mangi.</span></Titolo>
  <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 reveal-stagger">
    {vincoli.map((v) => (
        <a href={v.url} class="card p-4 sm:p-6 flex flex-col items-center text-center gap-2 relative overflow-hidden">
          <span class="absolute -right-6 -top-6 size-24 rounded-full opacity-40 transition-transform duration-700 group-hover:scale-150" style={`background:${v.colore}`} aria-hidden="true"></span>
          <span class="scoop w-10 sm:w-12 relative" style={`--c:${v.colore}`} aria-hidden="true"></span>
          <h3 class="relative text-lg sm:text-xl font-bold leading-tight">{v.nome}</h3>
        </a>
    ))}
  </div>
</section>
