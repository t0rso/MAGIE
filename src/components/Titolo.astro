---
/** Intestazione di sezione: occhiello + titolo con sottolineatura a pennello. */
interface Props { occhiello?: string; brush?: string; class?: string; center?: boolean; tag?: 'h1' | 'h2' }
const { occhiello, brush = 'var(--color-limone)', class: cls = '', center = false, tag = 'h2' } = Astro.props;
const Tag = tag;
---
<div class:list={['reveal', center && 'text-center', cls]}>
  {occhiello && <p class="text-sm font-black uppercase tracking-[.18em] text-fragola mb-3">{occhiello}</p>}
  <Tag class:list={['font-semibold', tag === 'h1' ? 'text-4xl sm:text-5xl md:text-6xl' : 'text-3xl sm:text-4xl md:text-5xl']} style={`--brush:${brush}`}>
    <slot />
  </Tag>
  {Astro.slots.has('sotto') && <p class="mt-4 text-lg text-cacao/90 max-w-2xl" class:list={[center && 'mx-auto']}><slot name="sotto" /></p>}
</div>
