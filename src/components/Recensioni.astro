---
import info from '../data/info.json';
---
<section class="container-page py-16">
  <p class="eyebrow text-center">Dicono di noi</p>
  <h2 class="mt-2 text-center text-3xl font-bold sm:text-4xl">
    <span class="text-[#F6A623]" aria-hidden="true">★</span> {info.google.voto.toFixed(1).replace('.', ',')} su Google
  </h2>
  <p class="mt-2 text-center text-cacao-700">{info.google.recensioni} recensioni · consigliata dal {info.facebook.consigliata}% su Facebook</p>
  <ul class="mt-10 grid gap-5 md:grid-cols-3">
    {info.recensioni.map((r) => (
      <li class="rounded-blob bg-white p-6 shadow-soft">
        <p class="text-[#F6A623]" aria-label={`${r.voto} stelle su 5`}>{'★'.repeat(r.voto)}<span class="text-cacao-900/10">{'★'.repeat(5 - r.voto)}</span></p>
        <p class="mt-3 text-cacao-700">“{r.testo}”</p>
        <p class="mt-4 text-sm font-semibold">{r.autore}</p>
      </li>
    ))}
  </ul>
  <p class="mt-6 text-center text-sm text-cacao-700">
    <a href={info.social.google} target="_blank" rel="noopener" class="underline underline-offset-4">Leggi tutte le recensioni su Google →</a>
  </p>
</section>
