---
import info from '../data/info.json';
const stelle = '★★★★★';
---
<section class="mx-auto max-w-6xl px-5 sm:px-6 pt-16 pb-16 md:pt-24 md:pb-20">
  <div class="grid gap-8 md:gap-10 md:grid-cols-[1fr_1.6fr] items-start">
    <div class="reveal text-center md:text-left">
      <p class="display text-6xl sm:text-7xl font-black leading-none text-fragola">{info.google.voto}</p>
      <p class="text-xl sm:text-2xl tracking-wider text-caramello">{stelle}</p>
      <p class="mt-2 font-extrabold">{info.google.recensioni} recensioni su Google</p>
      <a href={info.social.google} target="_blank" rel="noopener" class="btn-link mt-3 text-sm">Leggile tutte ↗</a>
    </div>
    <ul class="grid gap-3 sm:gap-4 reveal-stagger">
      {info.recensioni.slice(0, 3).map((r, i) => (
        <li class="card p-4 sm:p-5 relative" style={`transform: rotate(${(i % 2 ? 1 : -1) * 0.5}deg)`}>
          <p class="text-base sm:text-lg">“{r.testo}”</p>
          <p class="mt-2 text-sm font-extrabold text-cacao/70">{r.autore} · <span class="text-caramello">{stelle.slice(0, r.voto)}</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>
