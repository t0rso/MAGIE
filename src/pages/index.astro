---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import GustoCard from '../components/GustoCard.astro';
import Recensioni from '../components/Recensioni.astro';
import Mappa from '../components/Mappa.astro';
import Orari from '../components/Orari.astro';
import info from '../data/info.json';
import torteData from '../data/torte.json';
import { gusti } from '../lib/gusti';

---
<Base title={info.nome}>
  <Hero />

  <!-- Oggi in vetrina -->
  <section class="container-page py-16" id="oggi">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Mantecati stamattina</p>
        <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Oggi in vetrina</h2>
      </div>
      <a href="/gusti" class="btn-ghost">Tutti i gusti →</a>
    </div>
    <div id="griglia-oggi" class="mt-8 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
      {gusti.map((g) => <GustoCard gusto={g} compatto />)}
    </div>
    <p class="mt-6 text-center text-sm text-cacao-700">
      La vetrina cambia ogni giorno con la stagione. Alcuni gusti si esauriscono nel pomeriggio: se ne vuoi uno in particolare, <a href={`https://wa.me/${info.whatsapp}`} class="underline underline-offset-4">scrivici</a>.
    </p>
  </section>

  <!-- Perché MAGIE -->
  <section class="bg-cacao-900 text-crema-50">
    <div class="container-page grid gap-10 py-16 md:grid-cols-3">
      {[
        { icona: '🥛', titolo: 'Latte fresco, ogni giorno', testo: 'Arriva da un\'azienda dell\'alta pianura bolognese. Niente latte in polvere, niente basi pronte.' },
        { icona: '🍓', titolo: 'Frutta di stagione', testo: 'I sorbetti sono almeno 60% frutta. Per questo il melone c\'è solo ad agosto e il fico a settembre.' },
        { icona: '🌱', titolo: 'Vegano e senza lattosio', testo: 'Oltre ai sorbetti, creme 100% vegetali a base di mandorla o cocco. E il fondente lo è di natura.' },
      ].map((b) => (
        <div>
          <span class="grid size-12 place-items-center rounded-2xl bg-white/10 text-2xl" aria-hidden="true">{b.icona}</span>
          <h3 class="mt-4 text-xl font-bold">{b.titolo}</h3>
          <p class="mt-2 text-crema-200/80">{b.testo}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Torte -->
  <section class="container-page py-16">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div class="grid grid-cols-2 gap-4">
        {torteData.torte.map((t) => (
          <div class="flex aspect-square flex-col justify-end rounded-blob p-5 text-crema-50 shadow-soft" style={`background:${t.colore}`}>
            <p class="text-xs uppercase tracking-wider opacity-80">{t.porzioni} porzioni</p>
            <p class="font-display text-xl font-bold leading-tight">{t.nome}</p>
          </div>
        ))}
      </div>
      <div>
        <p class="eyebrow">Per le feste</p>
        <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Torte gelato e vaschette da portare a casa</h2>
        <p class="mt-4 text-cacao-700">
          Quattro torte di casa, oppure la tua su misura con i gusti che preferisci. Prenoti su WhatsApp in un minuto, passi a ritirare quando vuoi.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/torte#prenota" class="btn-accent">Prenota una torta</a>
          <a href="/torte" class="btn-ghost">Vedi il catalogo</a>
        </div>
      </div>
    </div>
  </section>

  <Recensioni />

  <!-- Dove siamo -->
  <section class="container-page py-16" id="dove">
    <p class="eyebrow">Vieni a trovarci</p>
    <h2 class="mt-2 text-3xl font-bold sm:text-4xl">{info.indirizzo.via}, {info.indirizzo.citta}</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-[1.4fr_1fr]">
      <Mappa />
      <Orari />
    </div>
  </section>
</Base>

<script>
  import { applicaOverride } from '../scripts/disponibilita';

  applicaOverride();

  // In home mostriamo solo i gusti disponibili oggi (max 8), nascondendo gli altri
  const griglia = document.getElementById('griglia-oggi')!;
  const cards = [...griglia.querySelectorAll<HTMLElement>('[data-gusto-id]')];
  let visibili = 0;
  for (const c of cards) {
    const ok = c.dataset.disponibile === 'true' && visibili < 8;
    c.hidden = !ok;
    if (ok) visibili++;
  }
  const totale = cards.filter((c) => c.dataset.disponibile === 'true').length;
  const conteggio = document.querySelector('[data-conteggio-oggi]');
  if (conteggio) conteggio.textContent = `${totale} gusti`;
</script>
