---
import Base from '../layouts/Base.astro';
import FormPrenotazione from '../components/FormPrenotazione.astro';
import torteData from '../data/torte.json';
import { testoSuColore } from '../lib/gusti';
---
<Base title="Torte gelato e vaschette" description="Torte gelato artigianali su prenotazione e vaschette da asporto. Prenota su WhatsApp con 48 ore di anticipo.">
  <section class="container-page py-12 sm:py-16">
    <p class="eyebrow">Da portare a casa</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Torte gelato & vaschette</h1>
    <p class="mt-4 max-w-2xl text-lg text-cacao-700">
      Le torte le facciamo noi, una per una, con lo stesso gelato del banco. Personalizzala come vuoi, oppure scegli una di casa.
      Tutto anche in versione vegana o con stevia.
    </p>

    <h2 class="mt-14 text-2xl font-bold">Le torte di casa</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {torteData.torte.map((t) => {
        const chiaro = testoSuColore(t.colore) === 'light';
        return (
          <li class:list={['flex gap-5 rounded-blob bg-white p-5 shadow-soft']}>
            <div class:list={['grid size-24 shrink-0 place-items-center rounded-3xl text-4xl', chiaro ? 'text-crema-50' : 'text-cacao-900']} style={`background:${t.colore}`} aria-hidden="true">
              {t.icona}
            </div>
            <div class="flex flex-col">
              <h3 class="text-xl font-bold">{t.nome}</h3>
              <p class="mt-1 text-sm text-cacao-700">{t.descrizione}</p>
              <p class="mt-auto pt-3 text-sm"><span class="font-semibold">{t.id === 'personalizzata' ? `da €${t.prezzo}` : `€${t.prezzo}`}</span> · {t.porzioni} porzioni</p>
            </div>
          </li>
        );
      })}
    </ul>

    <h2 class="mt-14 text-2xl font-bold">{torteData.pasticcini.titolo}</h2>
    <p class="mt-2 text-cacao-700">{torteData.pasticcini.descrizione}</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {torteData.pasticcini.formati.map((f) => (
        <li class="flex items-center justify-between rounded-blob border border-cacao-900/10 p-6">
          <p class="font-display text-2xl font-bold">Vassoio da {f.formato}</p>
          <p class="text-lg font-semibold">€{f.prezzo}</p>
        </li>
      ))}
    </ul>

    <h2 class="mt-14 text-2xl font-bold">Vaschette da asporto</h2>
    <p class="mt-2 text-cacao-700">Sempre disponibili al banco, con i gusti del giorno. Le confezioniamo con il ghiaccio secco se devi fare strada, oppure te le portiamo a casa.</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {torteData.vaschette.map((v) => (
        <li class="rounded-blob border border-cacao-900/10 p-6 text-center">
          <p class="font-display text-3xl font-bold">{v.formato}</p>
          <p class="mt-1 text-sm text-cacao-700">{v.gusti}</p>
          <p class="mt-3 text-lg font-semibold">€{v.prezzo}</p>
        </li>
      ))}
    </ul>

    <div id="prenota" class="mt-20 scroll-mt-24">
      <p class="eyebrow">Prenota</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Dicci cosa ti serve, ti rispondiamo su WhatsApp</h2>
      <div class="mt-8">
        <FormPrenotazione />
      </div>
    </div>
  </section>
</Base>
