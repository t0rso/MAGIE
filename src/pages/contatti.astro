---
import Base from '../layouts/Base.astro';
import Titolo from '../components/Titolo.astro';
import DoveSiamo from '../components/DoveSiamo.astro';
import Foto from '../components/Foto.astro';
import SocialButton from '../components/SocialButton.astro';
import info from '../data/info.json';
---
<Base title="Contatti e orari" description="Gelateria Magie: via Covignano 152, Rimini. Aperti tutti i giorni 14:30–24:00. Telefono, WhatsApp, mappa e consegna a domicilio.">
  <section class="">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 pt-8 md:pt-12 pb-4">
      <Titolo tag="h1" occhiello="Contatti" brush="var(--color-limone)">
        Siamo in <span class="underline-brush">via Covignano</span>, tutti i giorni dalle 14:30.
        <Fragment slot="sotto">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</Fragment>
      </Titolo>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 sm:px-6 pt-6 reveal">
    <Foto nome="esterno-sera" alt="L'ingresso della gelateria Magie di sera" ratio="21/9" nota="L'ingresso con i tavolini, di sera" sizes="(min-width: 1152px) 1152px, 100vw" />
  </div>
  <DoveSiamo compatto />

  <section class="mx-auto max-w-6xl px-5 sm:px-6 pb-10 grid gap-4 md:grid-cols-2 reveal-stagger">
    <div class="card p-5 sm:p-6">
      <h2 class="text-xl font-bold">Consegna a domicilio</h2>
      <p class="mt-1 text-cacao/85">{info.consegna.zona}. {info.consegna.note}</p>
    </div>
    <div class="card p-5 sm:p-6">
      <h2 class="text-xl font-bold">Il banco di oggi</h2>
      <p class="mt-1 text-cacao/85">Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
      <div class="mt-4 flex flex-wrap gap-3"><SocialButton tipo="instagram" class="btn-sm" /><SocialButton tipo="facebook" class="btn-sm" /></div>
    </div>
  </section>
</Base>
