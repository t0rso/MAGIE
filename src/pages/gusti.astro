---
import Base from '../layouts/Base.astro';
import GustoCard from '../components/GustoCard.astro';
import { gusti, CATEGORIE, TAG_FILTRI, ALLERGENI } from '../lib/gusti';
---
<Base title="I gusti" description="Tutti i gusti della gelateria MAGIE: creme, frutta e sorbetti, con allergeni e opzioni vegane, senza lattosio e senza glutine. Scopri cosa c'è in vetrina oggi.">
  <section class="container-page py-12 sm:py-16">
    <p class="eyebrow">La vetrina</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">I nostri gusti</h1>
    <p class="mt-4 max-w-2xl text-lg text-cacao-700">
      Ne facciamo circa venti, mai tutti insieme: in vetrina ce ne stanno sedici e li scegliamo ogni mattina in base a cosa arriva dal mercato.
    </p>

    <!-- Filtri -->
    <div class="-mx-5 mt-8 bg-crema-50/90 px-5 py-4 backdrop-blur sm:-mx-8 sm:px-8 md:sticky md:top-16 md:z-20" id="filtri">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Categoria">
          <button class="chip" data-filtro="categoria" data-valore="" aria-pressed="true">Tutti</button>
          {Object.entries(CATEGORIE).map(([k, v]) => (
            <button class="chip" data-filtro="categoria" data-valore={k} aria-pressed="false">{v}</button>
          ))}
          <span class="mx-1 hidden w-px self-stretch bg-cacao-900/10 sm:block" aria-hidden="true"></span>
          <button class="chip" data-filtro="oggi" aria-pressed="false">✨ Solo oggi in vetrina</button>
        </div>
        <label class="relative block">
          <span class="sr-only">Cerca un gusto</span>
          <input id="cerca" type="search" placeholder="Cerca un gusto…" class="w-full rounded-full border border-cacao-900/15 bg-white py-2.5 pl-10 pr-4 outline-none focus:border-cacao-900 lg:w-64" />
          <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-cacao-700" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </label>
      </div>
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Esigenze alimentari">
        {TAG_FILTRI.map((t) => (
          <button class="chip capitalize" data-filtro="tag" data-valore={t} aria-pressed="false">{t}</button>
        ))}
      </div>
    </div>

    <p class="mt-6 text-sm text-cacao-700" id="conteggio" aria-live="polite"></p>

    <div id="griglia" class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {gusti.map((g) => <GustoCard gusto={g} />)}
    </div>

    <div id="vuoto" class="hidden rounded-blob bg-white p-10 text-center shadow-soft">
      <p class="text-4xl" aria-hidden="true">🍧</p>
      <p class="mt-3 font-display text-2xl font-bold">Nessun gusto con questi filtri</p>
      <p class="mt-2 text-cacao-700">Prova a togliere qualche filtro, oppure chiedici al banco: qualcosa inventiamo.</p>
      <button id="reset" class="btn-ghost mt-5">Azzera filtri</button>
    </div>

    <!-- Legenda allergeni -->
    <aside class="mt-14 rounded-blob border border-cacao-900/10 p-6">
      <h2 class="font-bold">Allergeni</h2>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-cacao-700">
        {Object.values(ALLERGENI).map((a) => <li><span aria-hidden="true">{a.icona}</span> {a.label}</li>)}
      </ul>
      <p class="mt-3 text-xs text-cacao-700">
        Il laboratorio lavora latte, uova, glutine e frutta a guscio: non possiamo escludere contaminazioni accidentali. In caso di allergie gravi parlane con noi al banco.
      </p>
    </aside>
  </section>
</Base>

<script>
  import { applicaOverride } from '../scripts/disponibilita';

  applicaOverride();

  const stato = { categoria: '', tag: new Set<string>(), oggi: false, q: '' };
  const cards = [...document.querySelectorAll<HTMLElement>('#griglia [data-gusto-id]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const cerca = document.getElementById('cerca') as HTMLInputElement;
  const vuoto = document.getElementById('vuoto')!;
  const conteggio = document.getElementById('conteggio')!;

  function applica() {
    let n = 0;
    for (const c of cards) {
      const tags = c.dataset.tag?.split('|').filter(Boolean) ?? [];
      const ok =
        (!stato.categoria || c.dataset.categoria === stato.categoria) &&
        [...stato.tag].every((t) => tags.includes(t)) &&
        (!stato.oggi || c.dataset.disponibile === 'true') &&
        (!stato.q || c.dataset.nome!.includes(stato.q));
      c.hidden = !ok;
      if (ok) n++;
    }
    vuoto.classList.toggle('hidden', n > 0);
    const oggi = cards.filter((c) => c.dataset.disponibile === 'true').length;
    conteggio.textContent = n === cards.length
      ? `${cards.length} gusti in carta · ${oggi} in vetrina oggi`
      : `${n} ${n === 1 ? 'gusto trovato' : 'gusti trovati'}`;
  }

  function sync() {
    for (const ch of chips) {
      const { filtro, valore = '' } = ch.dataset;
      const on = filtro === 'categoria' ? stato.categoria === valore
        : filtro === 'tag' ? stato.tag.has(valore)
        : stato.oggi;
      ch.setAttribute('aria-pressed', String(on));
    }
    applica();
  }

  for (const ch of chips) {
    ch.addEventListener('click', () => {
      const { filtro, valore = '' } = ch.dataset;
      if (filtro === 'categoria') stato.categoria = valore;
      else if (filtro === 'tag') stato.tag.has(valore) ? stato.tag.delete(valore) : stato.tag.add(valore);
      else stato.oggi = !stato.oggi;
      sync();
    });
  }
  cerca.addEventListener('input', () => { stato.q = cerca.value.trim().toLowerCase(); applica(); });
  document.getElementById('reset')!.addEventListener('click', () => {
    stato.categoria = ''; stato.tag.clear(); stato.oggi = false; stato.q = ''; cerca.value = '';
    sync();
  });

  // Filtro iniziale da URL, es. /gusti?tag=vegano oppure /gusti?oggi
  const p = new URLSearchParams(location.search);
  if (p.get('tag')) stato.tag.add(p.get('tag')!);
  if (p.has('oggi')) stato.oggi = true;
  sync();
</script>
