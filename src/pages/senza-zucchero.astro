---
import Base from '../layouts/Base.astro';
import LandingVincolo from '../components/LandingVincolo.astro';
const faq = [
  { q: 'Con cosa dolcificate?', a: 'Con stevia, senza zuccheri aggiunti. Nei gusti di frutta resta lo zucchero naturale della frutta.' },
  { q: 'Va bene per chi ha il diabete?', a: 'Molti nostri clienti diabetici lo prendono da anni. Ma ogni caso è diverso: chiedi al tuo medico e al banco ti diciamo esattamente gli ingredienti di ogni gusto.' },
  { q: 'Si sente la stevia?', a: 'Nei gusti con cacao, nocciola o frutti di bosco quasi per niente. Nel fior di latte un po\' di più: è un gusto pulito, si nota tutto. Assaggia, te lo facciamo provare.' },
  { q: 'Torte senza zucchero?', a: 'Sì, su ordinazione con 2 giorni di preavviso. Anche senza glutine.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Gelato senza zucchero (con stevia) a Rimini" description="Gelato senza zuccheri aggiunti a Rimini, dolcificato con stevia: per diabetici, sportivi e chi vuole stare attento. Anche torte senza zucchero. Gelateria Magie, via Covignano 152." jsonLd={jsonLd}>
  <LandingVincolo
    id="stevia"
    occhiello="Gelato senza zucchero a Rimini"
    titolo="Senza zucchero. <span class='underline-brush'>Non senza gusto.</span>"
    intro="Dolcificato con stevia, senza zuccheri aggiunti. Nato per i clienti diabetici e per gli sportivi, finito nelle coppette di chi semplicemente vuole mangiarne un po' di più."
    punti={[
      { titolo: 'Solo stevia', testo: 'Niente zucchero, niente sciroppi. La stevia è una pianta: dolcifica senza calorie e senza alzare la glicemia.', daConfermare: true },
      { titolo: 'Ingredienti alla mano', testo: 'Per ogni gusto ti diciamo cosa c\'è dentro, grammo per grammo. Se devi contare i carboidrati, chiedi al banco.', daConfermare: true },
      { titolo: 'Anche vegano', testo: 'Cioccolato e frutti di bosco con stevia sono anche vegani e senza glutine. Per chi ha più di un vincolo.' },
    ]}
    faq={faq}
    foto="stevia"
    fotoAlt="Coppetta con gusti senza zucchero di Gelateria Magie"
    fotoNota="Coppetta con gusti stevia, in mano"
  />
</Base>
