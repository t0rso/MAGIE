---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata">
  <section class="min-h-[60vh] grid place-items-center text-center px-4">
    <div class="anim-drop">
      <p class="display text-8xl font-black text-fragola/80">404</p>
      <h1 class="mt-4 text-5xl font-semibold">Ops, è caduta.</h1>
      <p class="mt-3 text-lg text-cacao/90">Questa pagina non esiste. Il gelato però sì.</p>
      <a href="/" class="btn btn-primary mt-6">Torna alla home</a>
    </div>
  </section>
</Base>
