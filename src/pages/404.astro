---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata">
  <section class="sprinkles min-h-[60vh] grid place-items-center text-center px-4">
    <div class="anim-drop">
      <div class="relative mx-auto w-32">
        <span class="scoop w-32 block" style="--c:var(--color-fragola)"></span>
        <span class="absolute left-1/2 -bottom-6 -translate-x-1/2 text-5xl rotate-180">🍦</span>
      </div>
      <h1 class="mt-12 text-5xl font-semibold">Ops, è caduta.</h1>
      <p class="mt-3 text-lg text-cacao/90">Questa pagina non esiste. Il gelato però sì.</p>
      <a href="/" class="btn btn-primary mt-6">Torna alla home</a>
    </div>
  </section>
</Base>
